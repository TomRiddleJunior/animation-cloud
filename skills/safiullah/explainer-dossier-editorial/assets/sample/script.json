 "lines": [
  {
   "id": "hook",
   "text": "一九二三年十一月，柏林"
  },
  {
   "id": "hook2",
   "text": "这时候，一张钞票，还不如一张废纸值钱",
   "gap": 0.9
  },
  {
   "id": "rate1",
   "text": "一九一四年，一美元换四点二马克",
   "gap": 0.7
  },
  {
   "id": "rate2",
   "text": "九年后，要换四点二万亿",
   "gap": 0.35
  },
  {
   "id": "ruhr",
   "text": "真正把马克推下悬崖的，是鲁尔区。一九二三年一月，德国拖欠战争赔偿，法国和比利时出兵占领了这里",
   "gap": 0.8
  },
  {
   "id": "strike",
   "text": "政府号召消极抵抗。工人罢工，工资照发",
   "gap": 0.6
  },
  {
   "id": "print",
   "text": "钱从哪来？印",
   "gap": 0.35
  },
  {
   "id": "prices",
   "text": "到了秋天，物价几天就翻一倍。早上写好的价目表，到下午就作废了",
   "gap": 0.8
  },
  {
   "id": "losers",
   "text": "谁输了？存钱的人。一辈子的存款、养老金、债券，全部化为乌有",
   "gap": 0.75
  },
  {
   "id": "winners",
   "text": "谁赢了？欠钱的人，包括政府自己。它在国内欠下的战争债，几乎一笔勾销",
   "gap": 0.6
  },
  {
   "id": "renten",
   "text": "十一月十五日，新货币地租马克发行。一个新马克，兑一万亿旧马克。发行量，被严格限死",
   "gap": 0.8
  },
  {
   "id": "stop",
   "text": "恶性通胀，很快停了下来",
   "gap": 0.45
  },
  {
   "id": "trust",
   "text": "新马克背后没有黄金。撑住它的，是人们重新愿意相信的一样东西",
   "gap": 0.8
  },
  {
   "id": "end",
   "text": "信用",
   "gap": 0.55,
   "speed": 0.8
  }
 ]
